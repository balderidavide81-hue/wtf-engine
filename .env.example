# Comma-separated extra RSS source definitions:
# Name|URL|language|country,Name 2|URL|language|country
WTF_RSS_SOURCES=

# Set to 0 for an immediate kill switch on GDELT discovery lanes.
WTF_ENABLE_GDELT=1

# Server-side only. Never expose this value to clients.
OPENAI_API_KEY=
OPENAI_SCOUT_MODEL=gpt-5.6-luna
OPENAI_EDITOR_MODEL=gpt-5.6-luna

# Player-facing card language. v0.6 supports it/en; defaults to Italian.
EDITOR_OUTPUT_LANGUAGE=it

DATABASE_URL=
EDITORIAL_API_TOKEN=
GENERATION_API_TOKEN=

# Compatibility daily-edition timezone.
EDITION_TIME_ZONE=Europe/Rome
