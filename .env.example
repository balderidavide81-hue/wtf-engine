# Comma-separated RSS source definitions:
# Name|URL|language|country,Name 2|URL|language|country
WTF_RSS_SOURCES=

# Server-side only. Never expose this value to the browser.
OPENAI_API_KEY=

# Override only when testing a different model.
OPENAI_SCOUT_MODEL=gpt-5.6-luna
OPENAI_EDITOR_MODEL=gpt-5.6-luna

# Neon/Postgres connection string. Required by v0.5 generation/editorial/gameplay persistence.
DATABASE_URL=

# Server-side bearer secret for /api/editorial. Never expose to clients.
EDITORIAL_API_TOKEN=

# Server-side bearer secret for internal /api/collect, /api/scout and /api/daily operations.
GENERATION_API_TOKEN=

# IANA timezone used to assign generation/review/gameplay to a calendar edition.
EDITION_TIME_ZONE=Europe/Rome
